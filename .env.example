# 分析工具环境变量（PRD §9 / 开发交接文档）
# 值不提交到仓库；部署时在 Cloudflare Pages 环境变量中配置

# Plausible 自托管脚本地址（必填，上线前配置）
PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.example.com/js/script.js

# GA4 Measurement ID（必填，上线前配置；格式 G-XXXXXXXXXX）
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Clarity Project ID（必填，上线前配置）
PUBLIC_CLARITY_PROJECT_ID=xxxxxxx
