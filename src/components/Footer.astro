---
// 页脚 — 从设计稿迁移（9 页共用，文案按 SEO 冻结稿 §2）
// 链接：Privacy · Terms · FAQ · Report a data issue · Suggest a feature
// 附加声明：Not affiliated with Pocketpair, Inc. · Fan-made tool
// 数据版本徽章：构建期读取 version.json（PRD §5/§10）
import version from '../data/version.json';
---

<footer class="border-t border-border mt-24">
  <div class="max-w-[1280px] mx-auto px-6 py-12">
    <p class="text-sm text-onSurface/70 leading-relaxed max-w-2xl">
      <strong class="text-onSurface">PalBreed</strong> is a fan-made breeding calculator for Palworld players.
      Results use community-sourced data and are provided for informational purposes.
    </p>

    <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm" aria-label="Footer">
      <a href="/privacy" class="text-onSurface/80 hover:text-primary transition-colors">Privacy</a>
      <a href="/terms" class="text-onSurface/80 hover:text-primary transition-colors">Terms</a>
      <a href="/faq" class="text-onSurface/80 hover:text-primary transition-colors">FAQ</a>
      <a
        href="mailto:feedback@palbreed.space?subject=%5BBug%5D%20Data%20issue"
        class="text-onSurface/80 hover:text-primary transition-colors"
      >
        Report a data issue
      </a>
      <a
        href="mailto:feedback@palbreed.space?subject=%5BFeature%5D%20Request"
        class="text-onSurface/80 hover:text-primary transition-colors"
      >
        Suggest a feature
      </a>
    </nav>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-2 bg-primary/10 border border-primary/20 text-primary/90 px-3 py-1.5 rounded-md text-xs font-mono" title="Data source: tylercamp/palcalc (MIT)">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        Data: palcalc {version.datasetVersion} · {version.pairs.toLocaleString()} combos · updated {version.generatedAt}
      </span>
      <span class="text-xs text-onSurface/50 font-mono">src {version.sourceCommit.slice(0, 8)}</span>
    </div>

    <p class="mt-4 text-xs text-onSurface/50">
      Not affiliated with Pocketpair, Inc. · Fan-made tool · Game content © Pocketpair · Data © tylercamp/palcalc (MIT)
    </p>
  </div>
</footer>
