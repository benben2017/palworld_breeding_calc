---
// 页脚 — 从设计稿迁移（9 页共用，文案按 SEO 冻结稿 §2）
// v1.0.4：Popular Pals 缩减为 5 个最热门（12 个导致三列高度不齐）
// v1.0.6：移除数据版本徽章 + src 哈希（技术噪音；数据版本信息首页 hero 已有同款标签）
// v1.0.29：重新加回数据版本行（指向 /breeding-changes，与主页 badge 共用 breeding-changes.json）
// Popular Pals 从 TOP50 精选（community 共识热门，均有 index 详情页）

import changes from '../data/breeding-changes.json';

const dataUpdated = new Date(changes.updated + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const popularPals: { name: string; key: string }[] = [
  { name: 'Jetragon', key: 'jetdragon' },
  { name: 'Anubis', key: 'anubis' },
  { name: 'Shadowbeak', key: 'blackgriffon' },
  { name: 'Grizzbolt', key: 'elecpanda' },
  { name: 'Frostallion', key: 'icehorse' },
];
---

<footer class="border-t border-border mt-24">
  <div class="max-w-[1280px] mx-auto px-6 py-12">
    <p class="text-sm text-onSurface/70 leading-relaxed max-w-2xl">
      <strong class="text-onSurface">PalBreed</strong> is a fan-made breeding calculator for Palworld players.
      Results use community-sourced data and are provided for informational purposes.
    </p>

    {/* 4 列链接网格：Tools | Popular Pals | Resources | （Legal 并入底部声明）*/}
    <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-8 text-sm">
      <!-- Tools -->
      <nav aria-label="Tools">
        <h3 class="text-xs font-bold uppercase tracking-widest text-onSurface/60 mb-3">Tools</h3>
        <ul class="space-y-2.5">
          <li><a href="/" class="text-onSurface/80 hover:text-primary transition-colors">Breeding Calculator</a></li>
          <li><a href="/tools/cake-calculator" class="text-onSurface/80 hover:text-primary transition-colors">Cake Calculator</a></li>
          <li><a href="/pals" class="text-onSurface/80 hover:text-primary transition-colors">Pal List</a></li>
          <li><a href="/faq" class="text-onSurface/80 hover:text-primary transition-colors">FAQ</a></li>
        </ul>
      </nav>

      <!-- Popular Pals -->
      <nav aria-label="Popular Pals">
        <h3 class="text-xs font-bold uppercase tracking-widest text-onSurface/60 mb-3">Popular Pals</h3>
        <ul class="space-y-2.5">
          {popularPals.map((p) => (
            <li>
              <a href={`/pals/${p.key}`} class="text-onSurface/80 hover:text-primary transition-colors">{p.name}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Resources -->
      <nav aria-label="Resources">
        <h3 class="text-xs font-bold uppercase tracking-widest text-onSurface/60 mb-3">Resources</h3>
        <ul class="space-y-2.5">
          <li><a href="/privacy" class="text-onSurface/80 hover:text-primary transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-onSurface/80 hover:text-primary transition-colors">Terms of Service</a></li>
          <li>
            <a
              href="mailto:feedback@palbreed.space?subject=%5BBug%5D%20Data%20issue"
              class="text-onSurface/80 hover:text-primary transition-colors"
            >
              Report a data issue
            </a>
          </li>
          <li>
            <a
              href="mailto:feedback@palbreed.space?subject=%5BFeature%5D%20Request"
              class="text-onSurface/80 hover:text-primary transition-colors"
            >
              Suggest a feature
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="mt-6 text-xs">
      <a
        href="/breeding-changes"
        class="text-onSurface/60 hover:text-primary transition-colors"
      >
        Data v{changes.dataVersion} · Updated {dataUpdated}
      </a>
    </p>

    <p class="mt-2 text-xs text-onSurface/50">
      Not affiliated with Pocketpair, Inc. · Fan-made tool · Game content © Pocketpair · Data © tylercamp/palcalc (MIT)
    </p>
  </div>
</footer>
