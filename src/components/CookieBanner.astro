---
// Cookie Consent Banner — 从设计稿迁移（PRD v3 §9.3 / 合规交接）
// Accept All / Decline；移动端吸底；不遮挡工具输入区；适配三主题
---

<div
  id="cookie-banner"
  role="dialog"
  aria-label="Cookie consent"
  class="fixed bottom-0 left-0 right-0 z-[100] bg-surface border-t border-border p-4 shadow-2xl flex flex-col items-stretch gap-3 md:rounded-2xl md:bottom-6 md:right-6 md:left-auto md:w-[380px] md:border md:border-border md:p-5 md:gap-4"
>
  <div class="flex items-start gap-2">
    <span class="text-lg leading-none mt-0.5 shrink-0" aria-hidden="true">🍪</span>
    <div class="flex-1">
      <p class="text-sm font-black text-onSurface mb-1">We respect your privacy.</p>
      <p class="text-xs text-onSurface/70 leading-relaxed">
        Plausible runs automatically (no cookies); GA &amp; Clarity load only after you accept.
        <a class="text-primary underline" href="/privacy">Privacy Policy</a>
      </p>
    </div>
  </div>
  <div class="flex flex-col sm:flex-row gap-2 md:gap-2.5 w-full">
    <button
      data-consent="decline"
      class="flex-1 px-4 py-2.5 rounded-lg border border-border hover:bg-surface-elevated transition-all text-sm font-bold touch-target"
    >
      Decline
    </button>
    <button
      data-consent="accept"
      class="flex-1 px-4 py-2.5 rounded-lg bg-primary font-bold text-sm hover:opacity-90 transition-all touch-target"
    >
      Accept All
    </button>
  </div>
</div>
