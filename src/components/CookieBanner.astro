---
// Cookie Consent Banner — 从设计稿迁移（PRD v3 §9.3 / 合规交接）
// Accept All / Decline；移动端吸底；不遮挡工具输入区；适配三主题
---

<div
  id="cookie-banner"
  role="dialog"
  aria-label="Cookie consent"
  class="fixed bottom-0 left-0 right-0 z-[100] bg-surface border-t border-border p-3 shadow-2xl flex flex-col items-stretch gap-2 md:rounded-2xl md:bottom-6 md:left-1/2 md:-translate-x-1/2 md:w-[calc(100%-48px)] md:max-w-2xl md:border md:border-border md:p-6 md:flex-row md:items-center md:gap-6"
>
  <div class="flex-1">
    <p class="text-sm text-onSurface/80 leading-relaxed">
      <strong class="text-onSurface">We respect your privacy.</strong><br />
      Plausible runs automatically (no cookies); GA &amp; Clarity load only after you accept.
      <a class="text-primary underline" href="/privacy">Privacy Policy</a>
    </p>
  </div>
  <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
    <button
      data-consent="decline"
      class="flex-1 md:flex-none px-6 py-2 rounded-lg border border-border hover:bg-surface-elevated transition-all text-sm font-bold touch-target"
    >
      Decline
    </button>
    <button
      data-consent="accept"
      class="flex-1 md:flex-none px-6 py-2 rounded-lg bg-primary font-bold text-sm hover:opacity-90 transition-all touch-target"
    >
      Accept All
    </button>
  </div>
</div>
